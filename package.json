{
  "name": "tender",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "start": "pnpm --filter @tender/mobile start",
    "android": "pnpm --filter @tender/mobile android",
    "ios": "pnpm --filter @tender/mobile ios",
    "web": "pnpm --filter @tender/mobile web",
    "env:check": "pnpm --filter @tender/mobile env:check",
    "format": "pnpm --filter @tender/mobile format",
    "format:check": "pnpm --filter @tender/mobile format:check",
    "lint": "pnpm --filter @tender/mobile lint",
    "typecheck": "pnpm --filter @tender/mobile typecheck",
    "test": "pnpm --filter @tender/mobile test",
    "test:coverage": "pnpm --filter @tender/mobile test:coverage",
    "test:screenshots": "pnpm --filter @tender/mobile test:screenshots",
    "preflight": "pnpm env:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:lint": "supabase db lint --local --level error --fail-on error --schema public,app_private",
    "supabase:test": "supabase test db --local supabase/tests/database",
    "supabase:types": "node scripts/generate-database-types.mjs",
    "supabase:types:check": "node scripts/generate-database-types.mjs --check",
    "supabase:test:integration": "node scripts/run-database-integration.mjs",
    "supabase:test:integration:native": "node scripts/run-native-postgres-integration.mjs",
    "test:api-integration:native": "node scripts/run-native-postgres-integration.mjs --with-api",
    "supabase:test:integration:docker": "node scripts/run-supabase-integration.mjs",
    "supabase:verify": "node scripts/run-database-integration.mjs",
    "release:check:ios": "pnpm --filter @tender/mobile release:check",
    "release:e2e:ios": "pnpm --filter @tender/mobile test:e2e:store",
    "test:feature-integration": "node scripts/feature-integration/run.mjs",
    "content:weekly:check": "node scripts/compile-weekly-drafts.mjs --check",
    "test:flows": "node scripts/feature-integration/all.mjs",
    "test:flows:browser": "node scripts/feature-integration/all.mjs --browser-only",
    "test:flows:expanded": "node scripts/feature-integration/user-flows.mjs",
    "test:flows:services": "node scripts/service-integration/run.mjs",
    "test:flows:passwords": "node scripts/service-integration/passwords.mjs",
    "test:flows:storage": "node scripts/service-integration/docker-storage.mjs",
    "test:flows:phone:check": "node scripts/service-integration/phone-preflight.mjs",
    "test:flows:phone": "node scripts/phone-integration/run.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "supabase": "2.114.0",
    "vite": "8.0.3"
  }
}
