{
  "name": "@tender/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@hookform/resolvers": "^5.7.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@tender/domain": "workspace:*",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.14",
    "expo-calendar": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "env:check": "node ./scripts/check-public-env.mjs",
    "expo:check": "node ./scripts/check-expo-compatibility.mjs",
    "node:check": "node ./scripts/check-node-version.mjs",
    "lint": "expo lint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "release:check": "pnpm node:check && pnpm env:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm expo:check && node ./scripts/check-store-source.mjs",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:screenshots": "maestro test .maestro/today-journey-screenshots.yaml",
    "test:e2e:store": "maestro test .maestro/app-store-smoke.yaml"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "collectCoverageFrom": [
      "src/components/ui/**/*.{ts,tsx}",
      "!src/components/ui/index.ts",
      "src/config/**/*.{ts,tsx}",
      "src/features/today-journey/content-gate.ts",
      "src/features/today-journey/presentation.ts",
      "src/features/check-in/draft-state.ts",
      "src/features/journal/draft-state.ts",
      "src/features/journal/media-workflow.ts",
      "src/schemas/**/*.{ts,tsx}",
      "src/services/auth/**/*.{ts,tsx}",
      "src/stores/**/*.{ts,tsx}",
      "src/theme/**/*.{ts,tsx}",
      "../../packages/domain/src/**/*.{ts,tsx}"
    ],
    "moduleNameMapper": {
      "^@tender/domain$": "<rootDir>/../../packages/domain/src/index.ts"
    },
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
